# Path to the on-disk vault (armored ciphertext). Defaults to skarbiec.vault.json.
SKARBIEC_VAULT_FILE=

# Passphrase for a protected owner key, supplied for a single decrypt.
SKARBIEC_UNLOCK=

# MCP server gating (all three required to enable resolve over MCP):
SKARBIEC_MCP_CONSUMER=
SKARBIEC_MCP_TOKEN=
SKARBIEC_MCP_TOKEN_FILE=
SKARBIEC_MCP_OUT_DIR=
