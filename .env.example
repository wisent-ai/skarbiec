# Encrypted vault path. Defaults to ~/.local/share/skarbiec/skarbiec.vault.json.
SKARBIEC_VAULT_FILE=

# Passphrase for a protected owner key, supplied for a single decrypt.
SKARBIEC_UNLOCK=

# Owner-only passphrase file for a persistent service. Prefer this to
# SKARBIEC_UNLOCK in launchd/systemd configuration.
SKARBIEC_UNLOCK_FILE=

# Optional one-time field acquisition controls. TTL is a short integer duration
# in seconds. State contains hashes and scope metadata only and must remain an
# owner-only regular file.
# SKARBIEC_ACQUISITION_TTL_SECONDS=
# SKARBIEC_ACQUISITION_FILE=

# MCP server gating (all three required to enable resolve over MCP):
SKARBIEC_MCP_CONSUMER=
SKARBIEC_MCP_TOKEN=
SKARBIEC_MCP_TOKEN_FILE=
SKARBIEC_MCP_OUT_DIR=
