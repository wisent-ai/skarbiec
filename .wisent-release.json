{
  "schema_version": 1,
  "product": "skarbiec",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "Cargo.toml",
    "pattern": "(?m)^version\\s*=\\s*\"(?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)\"\\s*$"
  },
  "platforms": {
    "darwin-arm64": {
      "quality": [],
      "build": {
        "argv": [
          "bash",
          "release/build.sh"
        ]
      },
      "tests": [
        {
          "name": "serve-one-process",
          "argv": [
            "bash",
            "tests/release/journey.sh",
            "serve-one-process"
          ]
        },
        {
          "name": "vault-fence",
          "argv": [
            "bash",
            "tests/release/journey.sh",
            "vault-fence"
          ]
        }
      ],
      "stage": {
        "stage/bin/skarbiec": "bin/skarbiec",
        "stage/LICENSE": "LICENSE",
        "stage/NOTICE": "NOTICE"
      },
      "runner_platform": "darwin-arm64"
    },
    "linux-amd64": {
      "quality": [],
      "build": {
        "argv": [
          "bash",
          "release/build.sh"
        ]
      },
      "tests": [
        {
          "name": "serve-one-process",
          "argv": [
            "bash",
            "tests/release/journey.sh",
            "serve-one-process"
          ]
        },
        {
          "name": "vault-fence",
          "argv": [
            "bash",
            "tests/release/journey.sh",
            "vault-fence"
          ]
        }
      ],
      "env": {
        "SKARBIEC_EXTENSION_UPDATE_ORIGIN": "https://stado.wisent.com"
      },
      "secret_env": {
        "SKARBIEC_EXTENSION_PRIVATE_KEY_FILE": "browser-extension-signing#private_key"
      },
      "stage": {
        "stage/bin/skarbiec": "bin/skarbiec",
        "stage/share/skarbiec/browser/skarbiec-autofill.crx": "share/skarbiec/browser/skarbiec-autofill.crx",
        "stage/share/skarbiec/browser/skarbiec-autofill.xml": "share/skarbiec/browser/skarbiec-autofill.xml",
        "stage/LICENSE": "LICENSE",
        "stage/NOTICE": "NOTICE"
      },
      "runner_platform": "linux-amd64",
      "required": false
    }
  },
  "promotion": {
    "channels": [
      "candidate",
      "stable"
    ],
    "reconcile": false
  },
  "deliveries": [
    {
      "name": "fleet-darwin",
      "platform": "darwin-arm64",
      "argv": [
        "stado",
        "release",
        "local",
        "install",
        "--member",
        "bin/skarbiec"
      ],
      "required": true,
      "secret_env": {},
      "target": {
        "product": "skarbiec"
      }
    },
    {
      "name": "fleet-linux",
      "platform": "linux-amd64",
      "argv": [
        "stado",
        "release",
        "local",
        "install",
        "--member",
        "bin/skarbiec"
      ],
      "required": false,
      "secret_env": {},
      "target": {
        "product": "skarbiec"
      }
    }
  ],
  "inputs": {
    "private-cargo-sources": {
      "uri": "stado://sources/skarbiec/dependencies/private-cargo-sources/sha256/a817f09fbb7c1e80d692a783c28f8648d41fab1911a61d71cd5ae10d43bf2582/source.tar.gz",
      "sha256": "a817f09fbb7c1e80d692a783c28f8648d41fab1911a61d71cd5ae10d43bf2582",
      "mount": "private-cargo-sources",
      "extract": true
    }
  }
}
