{
  "schema_version": 1,
  "product": "skarbiec",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "Cargo.toml",
    "pattern": "(?m)^version\\s*=\\s*\"(?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)\"\\s*$"
  },
  "inputs": {
    "weles-client": {
      "uri": "stado://sources/skarbiec/dependencies/weles-client/sha256/0f0516a6bc1366e96d1e779163b0b9173082e9c501dfd912cab9625c75764056/source.tar.gz",
      "sha256": "0f0516a6bc1366e96d1e779163b0b9173082e9c501dfd912cab9625c75764056",
      "mount": "weles-client",
      "extract": true
    }
  },
  "platforms": {
    "darwin-arm64": {
      "quality": [
        {
          "name": "fmt",
          "argv": [
            "cargo",
            "fmt",
            "--",
            "--check"
          ]
        },
        {
          "name": "clippy",
          "argv": [
            "cargo",
            "clippy",
            "--locked",
            "--all-targets",
            "--keep-going",
            "--",
            "-D",
            "warnings"
          ]
        }
      ],
      "build": {
        "argv": [
          "bash",
          "release/build.sh"
        ]
      },
      "stage": {
        "stage/bin/skarbiec": "bin/skarbiec",
        "stage/bin/start": "bin/start",
        "stage/share/skarbiec/weles-client": "share/skarbiec/weles-client",
        "stage/LICENSE": "LICENSE",
        "stage/NOTICE": "NOTICE"
      },
      "runner_platform": "darwin-arm64"
    },
    "linux-amd64": {
      "quality": [
        {
          "name": "fmt",
          "argv": [
            "cargo",
            "fmt",
            "--",
            "--check"
          ]
        },
        {
          "name": "clippy",
          "argv": [
            "cargo",
            "clippy",
            "--locked",
            "--all-targets",
            "--keep-going",
            "--",
            "-D",
            "warnings"
          ]
        }
      ],
      "build": {
        "argv": [
          "bash",
          "release/build.sh"
        ]
      },
      "env": {
        "SKARBIEC_EXTENSION_UPDATE_ORIGIN": "https://stado.wisent.com"
      },
      "secret_env": {
        "SKARBIEC_EXTENSION_PRIVATE_KEY_FILE": "browser-extension-signing#private_key"
      },
      "stage": {
        "stage/bin/skarbiec": "bin/skarbiec",
        "stage/bin/start": "bin/start",
        "stage/share/skarbiec/weles-client": "share/skarbiec/weles-client",
        "stage/share/skarbiec/browser/skarbiec-autofill.crx": "share/skarbiec/browser/skarbiec-autofill.crx",
        "stage/share/skarbiec/browser/skarbiec-autofill.xml": "share/skarbiec/browser/skarbiec-autofill.xml",
        "stage/LICENSE": "LICENSE",
        "stage/NOTICE": "NOTICE"
      },
      "runner_platform": "linux-amd64",
      "required": false
    }
  },
  "promotion": {
    "channels": [
      "candidate",
      "stable"
    ],
    "reconcile": false
  }
}
